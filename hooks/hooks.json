{
  "description": "swarm-brake: hold heavy shell commands while the machine is short on memory or CPU, and clean up orphaned headless browsers",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" gate || true",
            "timeout": 120,
            "statusMessage": "swarm-brake: checking memory and CPU"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" done || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" done || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" reap || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" reap || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/swarm-brake\" reap || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
